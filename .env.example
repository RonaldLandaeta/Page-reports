# ─── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API. La URL y la anon key pueden ser públicas; la
# service_role NUNCA debe llevar el prefijo NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: en el servidor tiene prioridad sobre NEXT_PUBLIC_SUPABASE_URL.
# SUPABASE_URL=https://<ref>.supabase.co

# ─── Verificación de correo ──────────────────────────────────────────────────
# Firma los tokens que autorizan el envío de un reporte.
# Obligatorio en producción: mínimo 32 caracteres.
# Generar con: openssl rand -hex 32
VERIFICACION_SECRET=

# ─── Correo ──────────────────────────────────────────────────────────────────
# Se usa el primer proveedor configurado:
#   1. Resend (RESEND_API_KEY)
#   2. Gmail SMTP (GMAIL_USER + GMAIL_APP_PASSWORD)
#   3. Desarrollo (sin envío; el código se muestra en pantalla)
#
# En producción SIEMPRE debe haber un proveedor real: si el envío falla, la API
# responde 503/502 y no entrega el código. Nunca se simula un envío exitoso.
#
# Resend: crear API key en resend.com → API Keys.
# Sin dominio verificado, el remitente debe ser onboarding@resend.dev y solo
# llega al correo del dueño de la cuenta.
RESEND_API_KEY=
EMAIL_FROM=

# Gmail: activar verificación en 2 pasos y crear una "Contraseña de
# aplicaciones" (16 caracteres) en myaccount.google.com/security.
# No uses tu contraseña normal de Gmail.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ─── Correo institucional ────────────────────────────────────────────────────
# Dominio fijo y obligatorio: @est.ucab.edu.ve. Se valida en el servidor y no
# se configura por variable para que un despliegue no pueda abrirlo por error.

# ─── Panel de administración ─────────────────────────────────────────────────
# Duración EXACTA de la sesión de /admin, en horas. Máximo (y valor por
# defecto): 2. Solo puede acortarse (mínimo 0.25). No se renueva sola.
ADMIN_SESION_HORAS=2

# ─── Proxy / IP real ─────────────────────────────────────────────────────────
# Solo activar si la app corre detrás de un proxy de confianza (nginx,
# Traefik, etc.) que reescribe x-forwarded-for / x-real-ip. En Vercel y
# Cloudflare Pages se detecta automáticamente; no hace falta esta variable.
TRUST_PROXY_HEADERS=false

# ─── Desarrollo ──────────────────────────────────────────────────────────────
# Devuelve el código de verificación en la respuesta de la API. Solo funciona
# con NODE_ENV distinto de production; en producción se ignora.
MOSTRAR_CODIGO_DEMO=false
# Panel JSON con cédula y motivo en pantalla. Solo existe en desarrollo; en
# producción queda apagado siempre. Pon "false" para ocultarlo también en dev.
NEXT_PUBLIC_MOSTRAR_CONSOLA=false
